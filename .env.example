# =============================================================================
# CloseLoop: In-Database Reconciliation Engine for Exasol Personal
# Configuration Template (.env.example)
# Copy this file to .env and adjust your credentials
# =============================================================================

# Exasol Personal Connection Settings
# Use localhost:8563 for local Exasol Docker (offline dev) or cloud endpoint
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=CLOSELOOP
EXASOL_ENCRYPTION=True

# Engine Mode:
# Set CLOSELOOP_FORCE_LOCAL=True to run offline in pure in-memory SQL mode
CLOSELOOP_FORCE_LOCAL=False

# Operational Reconciliation Parameters
CONFIDENCE_THRESHOLD=0.90
MAX_SETTLEMENT_LAG_DAYS=3
MAX_ROUNDING_TOLERANCE=0.05
MAX_FUZZY_EDIT_DISTANCE=2

# Web Console Port
PORT=8501
